{
  "expo": {
    "name": "VALO Parking",
    "slug": "valor-parking",
    "owner": "veemon136",
    "scheme": "valo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/valo-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valoparking.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15171A",
        "foregroundImage": "./assets/valo-launcher-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.valoparking.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      ["expo-notifications", { "defaultChannel": "valo-notifications", "icon": "./assets/notification-icon.png", "color": "#E2BA4B" }],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VALO Parking to use the camera to photograph your vehicle registration."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "206a8337-a506-4bbd-bdd4-81e95109628c"
      }
    }
  }
}
