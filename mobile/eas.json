{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "local-demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.33:5001/api",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.1.33:5001",
        "EXPO_PUBLIC_ENV": "development"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
