EXPO_PUBLIC_API_URL=http://192.168.1.33:5001/api
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.33:5001
EXPO_PUBLIC_ENV=development
# Web OAuth client ID; must match backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Only needed for iOS builds. Android uses package + signing SHA-1 in Google Cloud.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
