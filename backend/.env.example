# Copy placeholders into a local environment. Never commit credentials.
TELEGRAM_ENABLED=false
# Optional reusable phone recipients and web receipt modal. Existing account delivery is unchanged.
TELEGRAM_PHONE_RECEIPTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Public frontend origin for membership renewal buttons; falls back to CLIENT_URL.
# Use a URL reachable from customers' phones, not localhost, for live reminders.
TELEGRAM_WEB_APP_URL=
# Membership reminders follow the existing renewal feature flag (enable explicitly in production).
# SUBSCRIPTION_RENEWAL_ENABLED=true
# Explicit ISO timestamp at rollout. Reconciler never sends events before this point.
TELEGRAM_EVENTS_FROM=
PARKING_PASS_QR_SECRET=
# Keep readers enabled when stopping issuance of new passes.
PARKING_PASS_ISSUE_ENABLED=false
PARKING_PASS_READ_ENABLED=true
KIOSK_SESSION_HOURS=24
# Same secret in the local Python barrier bridge environment; close acknowledgment only.
IOT_BRIDGE_SECRET=
