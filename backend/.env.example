# Copy placeholders into a local environment. Never commit credentials.
# Google Web OAuth client ID; same as mobile EXPO_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Explicit ISO timestamp at rollout. Reconciler never sends events before this point.
TELEGRAM_EVENTS_FROM=
PARKING_PASS_QR_SECRET=
# Keep readers enabled when stopping issuance of new passes.
PARKING_PASS_ISSUE_ENABLED=false
PARKING_PASS_READ_ENABLED=true
KIOSK_SESSION_HOURS=24
# Same secret in the local Python barrier bridge environment; close acknowledgment only.
IOT_BRIDGE_SECRET=
